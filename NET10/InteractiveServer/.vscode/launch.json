{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug InteractiveServer",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build InteractiveServer",
            "program": "${workspaceFolder}/bin/Debug/net10.0/InteractiveServer.dll",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "https://localhost:7219;http://localhost:5236"
            },
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s"
            }
        }
    ]
}