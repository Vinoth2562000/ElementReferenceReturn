{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Interactive WebAssembly",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/InteractiveWebAssembly/bin/Debug/net11.0/InteractiveWebAssembly.dll",
            "cwd": "${workspaceFolder}/InteractiveWebAssembly",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://127.0.0.1:0"
            },
            "serverReadyAction": {
                "action": "debugWithEdge",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s"
            }
        }
    ]
}